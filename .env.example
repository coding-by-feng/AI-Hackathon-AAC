# ── Chat panel ────────────────────────────────────────────────────────────
# Which provider answers questions in the dashboard Ask panel.
CHAT_PROVIDER=openai            # openai | gemini
CHAT_MODEL=                     # optional override; sensible default per provider

# Server-side only. NEVER prefix a key with NEXT_PUBLIC_ — that ships it to the
# browser, where it is readable from devtools in seconds.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Data ──────────────────────────────────────────────────────────────────
AAC_DB=./aac.db
# The demo has no login. This picks the viewer so every page still runs through
# the real roster-scoping path. Try adult_patel (teacher) or adult_parent_maya.
AAC_VIEWER=adult_patel
