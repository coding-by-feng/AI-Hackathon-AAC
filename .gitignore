# Generated by tools/build.sh — deterministic, never committed
aac.db
aac.db-wal
aac.db-shm
aac_text.db*

# Scratch and debug artifacts must never land in the repo root
/tmp/
*.tmp
.DS_Store
__pycache__/
*.pyc
node_modules/

# Next.js build output
.next/
tsconfig.tsbuildinfo

# Session-local Claude Code state
.claude/audit/
.claude/last-session-id

# Generated on demand by tools/export_csv.py
exports/

# Web app store (card customisations)
aac_app.db*

# Personal Claude Code overrides — not team config
.claude/settings.local.json

.playwright-cli/

# Secrets
.env.local
.env*.local
deploy/logs/
deploy/*.plist

# Feature-docs manifest: the manifest itself IS committed; its backups are not
docs/feature/.manifest.json.bak
docs/feature/.manifest.json.*
!docs/feature/.manifest.json
